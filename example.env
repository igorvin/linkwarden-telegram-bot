# Description: Example of .env file
# Usage: Copy this file to .env and fill the values
#        with your own values
#Create A telegram Bot and get the token from BotFather
TELEGRAM_TOKEN=your-telegram-token
#Create an access token on your Linkwarden server and paste the API key and URL here
LINKWARDEN_API_URL=https://linkwarden.example.com
# Optional browser-facing address, defaults to LINKWARDEN_API_URL
LINKWARDEN_PUBLIC_URL=
LINKWARDEN_API_KEY=your-api-key
# Numeric Telegram ID allowed to use the bot in a private chat
ALLOWED_TELEGRAM_USER_ID=your_telegram_user_id
# Optional group or supergroup. 0 disables group access.
ALLOWED_TELEGRAM_GROUP_ID=0
# Optional topic-to-collection mapping for this group, e.g. {"9":1}
TELEGRAM_TOPIC_COLLECTIONS={}

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: WARNING)
LOG_LEVEL=WARNING

# Rate limiting: max messages per user per time window (default: 10 per 60 seconds)
RATE_LIMIT_THRESHOLD=10
RATE_LIMIT_WINDOW=60

# Maximum message size in bytes (default: 51200 = 50KB)
MAX_MESSAGE_SIZE=51200
